POSTGRES_DB=academy_os_db
POSTGRES_USER=postgre
POSTGRES_PASSWORD=root

SECRET_KEY=changer-cette-cle-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=7
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_URL=postgres://postgre:root@postgres:5432/academy_os_db

# WebSockets (temps réel notifications) — Redit du réseau Docker
CHANNEL_REDIS_URL=redis://redis:6379/0

# Premier admin : créé automatiquement au 1er démarrage Docker si aucun admin n'existe.
# Placeholders uniquement ici — mets les vrais secrets dans .env et change le mot de passe
# après le premier login. Évite les '$' (interpolation compose). Ne le laisse jamais en prod.
DJANGO_SUPERUSER_EMAIL=change-me@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-password

# Email (Console par défaut pour le dev local sans config)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Pour activer l'envoi réel via SMTP (ex. Gmail avec mot de passe d'application) :
# 1. Activez l'authentification 2FA sur votre compte Google
# 2. Générez un "Mot de passe d'application" dans Sécurité > Mots de passe des applications
# 3. Renseignez les variables ci-dessous dans votre .env :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-email@gmail.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-application-16-lettres
# DEFAULT_FROM_EMAIL="Xarala Academy <votre-email@gmail.com>"

# URL du frontend pour les liens cliquables dans les emails
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PASSWORD_PATH=/reset-password
FRONTEND_ACTIVATE_ACCOUNT_PATH=/invite-reset-password
FRONTEND_COHORTS_PATH=/programmes
FRONTEND_LOGO_PATH=/logo-xarala.png

# Stockage des fichiers : 'local' (défaut) ou 's3' (S3-compatible : R2, B2, Spaces, AWS)
STORAGE_BACKEND=local
# Décommenter pour le stockage objet (ex. Cloudflare R2) :
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=academy-os-attachments
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION_NAME=auto
