SECRET_KEY=changer-cette-cle-en-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
ACCESS_TOKEN_LIFETIME=15
REFRESH_TOKEN_LIFETIME=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000
DATABASE_URL=postgres://postgre:root@postgres:5432/academy_os_db

# Premier admin : créé automatiquement (aussi en local via `manage.py ensure_admin`)
# si aucun admin n'existe. Placeholders uniquement — vrais secrets dans .env.
DJANGO_SUPERUSER_EMAIL=change-me@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-password

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=ton-mail@gmail.com
EMAIL_HOST_PASSWORD=ton-mot-de-passe-application
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@xarala.co

# Stockage des fichiers : 'local' (défaut) ou 's3' (S3-compatible : R2, B2, Spaces, AWS)
STORAGE_BACKEND=local
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=academy-os-attachments
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION_NAME=auto


FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PASSWORD_PATH=/reset-password
FRONTEND_ACTIVATE_ACCOUNT_PATH=/invite-reset-password
FRONTEND_COHORTS_PATH=/programmes
FRONTEND_LOGO_PATH=/logo-xarala.png